<Window x:Class="HeartRateShare.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享心率" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        Background="{StaticResource PageBg}" FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="White">
      <StackPanel Margin="12,20,12,12">
        <TextBlock Text="共享心率" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextMain}" Margin="12,0,0,20"/>
        <Border x:Name="NavHeart" CornerRadius="12" Background="{StaticResource AccentSoft}"
                Margin="0,0,0,6" Padding="12,10" MouseLeftButtonDown="Nav_Click" Tag="heart">
          <TextBlock x:Name="NavHeartText" Text="♥  心率" FontSize="15" Foreground="{StaticResource Accent}"/>
        </Border>
        <Border x:Name="NavRoom" CornerRadius="12" Background="Transparent"
                Margin="0,0,0,6" Padding="12,10" MouseLeftButtonDown="Nav_Click" Tag="room">
          <TextBlock x:Name="NavRoomText" Text="👥  房间" FontSize="15" Foreground="{StaticResource TextDim}"/>
        </Border>
        <Border x:Name="NavSettings" CornerRadius="12" Background="Transparent"
                Padding="12,10" MouseLeftButtonDown="Nav_Click" Tag="settings">
          <TextBlock x:Name="NavSettingsText" Text="⚙  设置" FontSize="15" Foreground="{StaticResource TextDim}"/>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1">
      <!-- 心率页 -->
      <ScrollViewer x:Name="HeartPanel" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
          <TextBlock Text="当前心率" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
          <TextBlock x:Name="TransportText" Text="未连接" FontSize="13"
                     Foreground="{StaticResource TextDim}" Margin="0,4,0,16"/>

          <Border Background="White" CornerRadius="16" Padding="24">
            <StackPanel>
              <Grid Height="150">
                <TextBlock Text="♥" FontSize="150" Foreground="#14FF5252"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="BpmText" Text="--" FontSize="96" FontWeight="Bold"
                           Foreground="{StaticResource TextMain}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="BPM" FontSize="14" Foreground="{StaticResource TextDim}"
                         HorizontalAlignment="Center"/>
              <Grid Height="170" Margin="0,16,0,0">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
              </Grid>
              <Grid Margin="0,4,0,0">
                <TextBlock Text="-60s" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Left"/>
                <TextBlock Text="最新" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="24" Background="{StaticResource Accent}" Height="48">
              <Button Content="扫描设备" Foreground="White" Background="Transparent"
                      BorderThickness="0" FontSize="15" Click="Scan_Click"/>
            </Border>
            <Border Grid.Column="2" CornerRadius="24" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" Height="48">
              <Button Content="断开连接" Foreground="{StaticResource Accent}" Background="Transparent"
                      BorderThickness="0" FontSize="15" Click="Disconnect_Click"/>
            </Border>
          </Grid>

          <Border Background="White" CornerRadius="16" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="房间成员" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
              <TextBlock x:Name="MemberHint" FontSize="12" Foreground="{StaticResource TextDim}"
                         Margin="0,4,0,8" TextWrapping="Wrap" Text="还没有数据：先连蓝牙设备，或到「房间」页连局域网/云端"/>
              <StackPanel x:Name="MemberList"/>
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="16" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="蓝牙设备" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
              <TextBlock x:Name="BleHint" FontSize="12" Foreground="{StaticResource TextDim}"
                         Margin="0,4,0,8" TextWrapping="Wrap"
                         Text="点「扫描设备」开始；只列广播带 0x180D 的心率设备"/>
              <StackPanel x:Name="BleList"/>
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="16" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="局域网投射（手机）" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
              <StackPanel x:Name="LanList" Margin="0,4,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ManualIp" Grid.Column="0" Height="40" FontSize="13"
                         VerticalContentAlignment="Center" Padding="10,0"
                         ToolTip="手机 IP 或 IP:端口，例如 192.168.1.20:8770"/>
                <Border Grid.Column="2" CornerRadius="20" Background="{StaticResource Accent}" Height="40">
                  <Button Content="连接" Foreground="White" Background="Transparent"
                          BorderThickness="0" Padding="20,0" Click="Manual_Click"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 房间页 -->
      <ScrollViewer x:Name="RoomPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
          <TextBlock Text="房间" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
          <TextBlock Text="云端与局域网用同一套 v1 协议；房间号 1–64 位字母/数字/下划线/短横线"
                     FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,4,0,16"/>
          <Border Background="White" CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="云端服务器" FontSize="13" Foreground="{StaticResource TextDim}"/>
              <TextBox x:Name="ServerBox" Height="40" Margin="0,6,0,12" FontSize="13"
                       VerticalContentAlignment="Center" Padding="10,0" Text="wss://heart.mawj.asia:10086"/>
              <TextBlock Text="房间号（留空则随机生成）" FontSize="13" Foreground="{StaticResource TextDim}"/>
              <TextBox x:Name="RoomBox" Height="40" Margin="0,6,0,12" FontSize="13"
                       VerticalContentAlignment="Center" Padding="10,0"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="20" Background="{StaticResource Accent}" Height="44">
                  <Button Content="创建/加入云端" Foreground="White" Background="Transparent"
                          BorderThickness="0" Click="Cloud_Click"/>
                </Border>
                <Border Grid.Column="2" CornerRadius="20" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" Height="44">
                  <Button Content="发现局域网手机" Foreground="{StaticResource Accent}" Background="Transparent"
                          BorderThickness="0" Click="LanDiscover_Click"/>
                </Border>
                <Border Grid.Column="4" CornerRadius="20" Background="{StaticResource PageBg}" Height="44">
                  <Button Content="复制房间号" Background="Transparent" BorderThickness="0" Click="CopyRoom_Click"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="White" CornerRadius="16" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="当前房间" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
              <TextBlock x:Name="RoomCodeText" FontSize="22" Margin="0,8,0,0"
                         Foreground="{StaticResource Accent}" Text="—"/>
              <TextBlock x:Name="RoomStatusText" FontSize="12" Foreground="{StaticResource TextDim}"
                         Margin="0,6,0,0" TextWrapping="Wrap"/>
              <StackPanel x:Name="LanPeers" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 设置页 -->
      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
          <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
          <Border Background="White" CornerRadius="16" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="显示名称" FontSize="13" Foreground="{StaticResource TextDim}"/>
              <TextBox x:Name="NameBox" Height="40" Margin="0,6,0,14" FontSize="13"
                       VerticalContentAlignment="Center" Padding="10,0" Text="Windows"/>
              <CheckBox x:Name="OverlayBox" Content="连接后显示透明悬浮窗" IsChecked="True" FontSize="14" Margin="0,0,0,12"/>
              <CheckBox x:Name="ShowAllBleBox" Content="显示全部蓝牙设备（默认只列心率设备）" FontSize="14" Margin="0,0,0,12"/>
              <TextBlock Text="悬浮窗心率字号" FontSize="13" Foreground="{StaticResource TextDim}"/>
              <Slider x:Name="FontSlider" Minimum="24" Maximum="96" TickFrequency="4"
                      IsSnapToTickEnabled="True" Value="48" Margin="0,6,0,0"
                      ValueChanged="Font_Changed"/>
            </StackPanel>
          </Border>
          <Border Background="White" CornerRadius="16" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="诊断" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
              <TextBlock x:Name="LogPathText" FontSize="12" Foreground="{StaticResource TextDim}"
                         Margin="0,8,0,8" TextWrapping="Wrap"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="20" Background="{StaticResource Accent}" Height="40">
                  <Button Content="打开日志目录" Foreground="White" Background="Transparent"
                          BorderThickness="0" Padding="16,0" Click="OpenLogs_Click"/>
                </Border>
              </Grid>
              <TextBlock x:Name="AboutText" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
