<Application x:Class="HeartRateShare.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1FFF5252"/>
    <SolidColorBrush x:Key="PageBg" Color="#FAF7F7"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextDim" Color="#9A9A9A"/>
  </Application.Resources>
</Application>
