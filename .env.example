# 复制为 .env 后按需修改：docker compose 会自动读取同目录的 .env
PORT=8765
ROOM_LIMIT=20
OFFLINE_TIMEOUT_MS=5000
MAX_CLIENTS=200
LOG_LEVEL=info

# ---- 日志落盘（compose 会把 LOG_DIR 挂到 LOG_HOST_DIR）----
# 宿主机目录必须先给容器内 uid 1000 权限：
#   install -d -o 1000 -g 1000 -m 0750 ./logs
LOG_HOST_DIR=./logs
LOG_DIR=/app/logs
LOG_MAX_BYTES=20971520
LOG_MAX_FILES=5
# 日志时间戳按这个时区写（带偏移），和手机本地时间对齐
TZ=Asia/Shanghai

# 镜像引用：默认跟着 latest 走；回滚时改成 IMAGE=mawjgit/heart-rate-share@sha256:<digest>
# 注意：旧的 IMAGE_TAG 已废弃（tag 无法表达 digest），留着也不会生效
# IMAGE=mawjgit/heart-rate-share:latest
