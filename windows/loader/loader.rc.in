// 由 CI 渲染：@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@BUILD@
#include <windows.h>
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@BUILD@
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@BUILD@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "WJMA"
            VALUE "FileDescription", "HeartRateShare launcher"
            VALUE "FileVersion", "@VERSION@.@BUILD@"
            VALUE "InternalName", "heartrate-loader"
            VALUE "OriginalFilename", "heartrate-win-x64.exe"
            VALUE "ProductName", "HeartRateShare"
            VALUE "ProductVersion", "@VERSION@.@BUILD@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
